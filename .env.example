# Copy to .env locally / set on Hostinger — never commit real values
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# Gmail SMTP for new-order email. SMTP_PASS is a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional seed only — after first deploy, manage recipients in Superadmin → Order place email alerts
# (table order_notify_emails). Env is ignored once that table has rows.
ORDER_NOTIFY_EMAILS=owner@example.com, second@example.com
SUPERADMIN_EMAILS=

# Edge/proxy IPs to never store or show as customer IP (comma-separated).
# 5.90.143.78 is already ignored in code (Hostinger hop). Add more if needed.
IGNORE_IPS=

# AI Product Assist (admin form). Off unless set to true. Uses the Gemini free tier.
AI_PRODUCT_ASSIST_ENABLED=
GEMINI_API_KEY=
